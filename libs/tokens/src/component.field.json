{
  "pct": {
    "field": {
      "$comment": "Obudowa rysuje ramkę pola, bo sloty prefix/suffix muszą znaleźć się w jej środku. Kontrolka wewnątrz jest przezroczysta i bez obramowania. Wysokość wiersza bierze się z tokenu wspólnego z przyciskiem ({pct.control.height}), nie z paddingu pionowego — wiersz pola i przycisk tej samej wielkości są przez to równe z definicji (wym-api-wielkosc).",
      "bg": { "$type": "color", "$value": "{pct.surface}" },
      "fg": { "$type": "color", "$value": "{pct.text}" },
      "placeholder-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "border": { "$type": "color", "$value": "{pct.border-strong}" },
      "border-hover": { "$type": "color", "$value": "{pct.text-muted}" },
      "border-focus": { "$type": "color", "$value": "{pct.primary}" },
      "border-invalid": { "$type": "color", "$value": "{pct.danger}" },
      "fg-invalid": { "$type": "color", "$value": "{pct.danger}" },
      "bg-disabled": { "$type": "color", "$value": "{pct.surface-disabled}" },
      "fg-disabled": { "$type": "color", "$value": "{pct.text-disabled}" },
      "border-disabled": { "$type": "color", "$value": "{pct.border}" },
      "label-fg": { "$type": "color", "$value": "{pct.text}" },
      "hint-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "affix-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "radius": { "$type": "dimension", "$value": "{pct.radius.md}" },
      "height": { "$type": "dimension", "$value": "{pct.control.height.md}" },
      "height-sm": {
        "$type": "dimension",
        "$value": "{pct.control.height.sm}"
      },
      "height-lg": {
        "$type": "dimension",
        "$value": "{pct.control.height.lg}"
      },
      "font-size": { "$type": "dimension", "$value": "{pct.font.size.md}" },
      "font-size-sm": { "$type": "dimension", "$value": "{pct.font.size.sm}" },
      "font-size-lg": { "$type": "dimension", "$value": "{pct.font.size.lg}" },
      "padding-x": { "$type": "dimension", "$value": "{pct.space.4}" },
      "padding-x-sm": { "$type": "dimension", "$value": "{pct.space.3}" },
      "padding-x-lg": { "$type": "dimension", "$value": "{pct.space.5}" },
      "gap": { "$type": "dimension", "$value": "{pct.space.3}" },
      "label-gap": { "$type": "dimension", "$value": "{pct.space.2}" }
    }
  }
}
