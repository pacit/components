{
  "pct": {
    "button": {
      "bg": { "$type": "color", "$value": "{pct.primary}" },
      "bg-hover": { "$type": "color", "$value": "{pct.primary-hover}" },
      "bg-active": { "$type": "color", "$value": "{pct.primary-active}" },
      "fg": { "$type": "color", "$value": "{pct.on-primary}" },
      "border": { "$type": "color", "$value": "{pct.primary}" },
      "disabled-bg": { "$type": "color", "$value": "{pct.disabled-bg}" },
      "disabled-fg": { "$type": "color", "$value": "{pct.disabled-fg}" },
      "disabled-border": { "$type": "color", "$value": "{pct.border}" },
      "radius": { "$type": "dimension", "$value": "{pct.radius.md}" },
      "font-size": { "$type": "dimension", "$value": "{pct.font.size.md}" },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{pct.font.weight.medium}"
      },
      "padding-y": { "$type": "dimension", "$value": "{pct.space.3}" },
      "padding-x": { "$type": "dimension", "$value": "{pct.space.5}" }
    }
  }
}
