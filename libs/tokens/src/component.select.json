{
  "pct": {
    "select": {
      "bg": { "$type": "color", "$value": "{pct.surface}" },
      "fg": { "$type": "color", "$value": "{pct.text}" },
      "placeholder-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "border": { "$type": "color", "$value": "{pct.border-strong}" },
      "border-hover": { "$type": "color", "$value": "{pct.text-muted}" },
      "border-focus": { "$type": "color", "$value": "{pct.primary}" },
      "border-invalid": { "$type": "color", "$value": "{pct.danger}" },
      "fg-invalid": { "$type": "color", "$value": "{pct.danger}" },
      "bg-disabled": { "$type": "color", "$value": "{pct.surface-disabled}" },
      "fg-disabled": { "$type": "color", "$value": "{pct.text-disabled}" },
      "border-disabled": { "$type": "color", "$value": "{pct.border}" },
      "label-fg": { "$type": "color", "$value": "{pct.text}" },
      "hint-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "arrow-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "radius": { "$type": "dimension", "$value": "{pct.radius.md}" },
      "font-size": { "$type": "dimension", "$value": "{pct.font.size.md}" },
      "padding-y": { "$type": "dimension", "$value": "{pct.space.3}" },
      "padding-x": { "$type": "dimension", "$value": "{pct.space.4}" },

      "panel-bg": { "$type": "color", "$value": "{pct.surface}" },
      "panel-border": { "$type": "color", "$value": "{pct.border-strong}" },
      "panel-shadow": { "$type": "shadow", "$value": "{pct.shadow-panel}" },
      "panel-radius": { "$type": "dimension", "$value": "{pct.radius.md}" },
      "panel-max-height": { "$type": "dimension", "$value": "240px" },

      "option-fg": { "$type": "color", "$value": "{pct.text}" },
      "option-bg": { "$type": "color", "$value": "{pct.surface}" },
      "option-bg-active": { "$type": "color", "$value": "{pct.surface-100}" },
      "option-fg-active": { "$type": "color", "$value": "{pct.text}" },
      "option-bg-selected": { "$type": "color", "$value": "{pct.primary}" },
      "option-fg-selected": { "$type": "color", "$value": "{pct.on-primary}" },
      "option-fg-disabled": {
        "$type": "color",
        "$value": "{pct.text-disabled}"
      },
      "option-padding-y": { "$type": "dimension", "$value": "{pct.space.3}" },
      "option-padding-x": { "$type": "dimension", "$value": "{pct.space.4}" },

      "$comment-group-label": "A section heading inside the panel — a `<optgroup>`'s label. It is not a row: it takes no value and the keyboard walks past it, so it is set apart by weight and a quieter colour rather than by a rule the panel would have to draw.",
      "group-label-fg": { "$type": "color", "$value": "{pct.text-muted}" },
      "group-label-font-size": {
        "$type": "dimension",
        "$value": "{pct.font.size.sm}"
      },
      "group-label-font-weight": {
        "$type": "fontWeight",
        "$value": "{pct.font.weight.medium}"
      },
      "group-label-padding-y": {
        "$type": "dimension",
        "$value": "{pct.space.2}"
      },
      "group-label-padding-x": {
        "$type": "dimension",
        "$value": "{pct.space.4}"
      }
    }
  }
}
