{
  "pct": {
    "checkbox": {
      "size": {
        "$type": "dimension",
        "$value": "18px",
        "$description": "Size of the box."
      },
      "target-min": {
        "$type": "dimension",
        "$value": "{pct.target.min}",
        "$description": "Touch-target floor of the box."
      },
      "bg": {
        "$type": "color",
        "$value": "{pct.surface}",
        "$description": "Background of the box."
      },
      "border": {
        "$type": "color",
        "$value": "{pct.border-strong}",
        "$description": "Edge colour of the box."
      },
      "border-hover": {
        "$type": "color",
        "$value": "{pct.text-muted}",
        "$description": "Edge colour of the box on hover."
      },
      "radius": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Corner radius of the box."
      },
      "bg-checked": {
        "$type": "color",
        "$value": "{pct.primary}",
        "$description": "Background of the box when checked."
      },
      "border-checked": {
        "$type": "color",
        "$value": "{pct.primary}",
        "$description": "Edge colour of the box when checked."
      },
      "fg-checked": {
        "$type": "color",
        "$value": "{pct.on-primary}",
        "$description": "Colour of the check mark."
      },
      "border-invalid": {
        "$type": "color",
        "$value": "{pct.danger}",
        "$description": "Edge colour of the box when invalid."
      },
      "fg-invalid": {
        "$type": "color",
        "$value": "{pct.danger}",
        "$description": "Colour of the check mark when invalid."
      },
      "bg-disabled": {
        "$type": "color",
        "$value": "{pct.surface-disabled}",
        "$description": "Background of the box while disabled."
      },
      "border-disabled": {
        "$type": "color",
        "$value": "{pct.border}",
        "$description": "Edge colour of the box while disabled."
      },
      "fg-disabled": {
        "$type": "color",
        "$value": "{pct.text-disabled}",
        "$description": "Colour of the check mark while disabled."
      },
      "label-fg": {
        "$type": "color",
        "$value": "{pct.text}",
        "$description": "Text colour of the label."
      },
      "hint-fg": {
        "$type": "color",
        "$value": "{pct.text-muted}",
        "$description": "Text colour of the hint."
      },
      "gap": {
        "$type": "dimension",
        "$value": "{pct.space.3}",
        "$description": "Gap between the box and its label."
      }
    }
  }
}
