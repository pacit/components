{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "core/**/*.ts",
    "button/**/*.ts",
    "checkbox/**/*.ts",
    "dialog/**/*.ts",
    "radio/**/*.ts",
    "select/**/*.ts",
    "tooltip/**/*.ts",
    "popover/**/*.ts",
    "menu/**/*.ts",
    "field/**/*.ts",
    "icon/**/*.ts",
    "testing/**/*.ts"
  ]
}
