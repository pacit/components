{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "core/**/*.ts",
    "accordion/**/*.ts",
    "button/**/*.ts",
    "checkbox/**/*.ts",
    "date/**/*.ts",
    "dialog/**/*.ts",
    "drawer/**/*.ts",
    "radio/**/*.ts",
    "slider/**/*.ts",
    "toast/**/*.ts",
    "switch/**/*.ts",
    "tabs/**/*.ts",
    "select/**/*.ts",
    "tooltip/**/*.ts",
    "popover/**/*.ts",
    "menu/**/*.ts",
    "pagination/**/*.ts",
    "progress/**/*.ts",
    "skeleton/**/*.ts",
    "chips/**/*.ts",
    "avatar/**/*.ts",
    "badge/**/*.ts",
    "breadcrumb/**/*.ts",
    "stepper/**/*.ts",
    "tree/**/*.ts",
    "container/**/*.ts",
    "stack/**/*.ts",
    "grid/**/*.ts",
    "theme/**/*.ts",
    "field/**/*.ts",
    "icon/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
