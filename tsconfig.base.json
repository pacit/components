{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@pacit/components": ["./libs/components/src/index.ts"],
      "@pacit/tokens": ["./libs/tokens/dist/tokens.ts"],
      "@pacit/components/core": ["./libs/components/core/src/index.ts"],
      "@pacit/components/accordion": [
        "./libs/components/accordion/src/index.ts"
      ],
      "@pacit/components/button": ["./libs/components/button/src/index.ts"],
      "@pacit/components/checkbox": ["./libs/components/checkbox/src/index.ts"],
      "@pacit/components/radio": ["./libs/components/radio/src/index.ts"],
      "@pacit/components/date": ["./libs/components/date/src/index.ts"],
      "@pacit/components/slider": ["./libs/components/slider/src/index.ts"],
      "@pacit/components/switch": ["./libs/components/switch/src/index.ts"],
      "@pacit/components/tabs": ["./libs/components/tabs/src/index.ts"],
      "@pacit/components/select": ["./libs/components/select/src/index.ts"],
      "@pacit/components/dialog": ["./libs/components/dialog/src/index.ts"],
      "@pacit/components/drawer": ["./libs/components/drawer/src/index.ts"],
      "@pacit/components/field": ["./libs/components/field/src/index.ts"],
      "@pacit/components/icon": ["./libs/components/icon/src/index.ts"],
      "@pacit/components/tooltip": ["./libs/components/tooltip/src/index.ts"],
      "@pacit/components/popover": ["./libs/components/popover/src/index.ts"],
      "@pacit/components/menu": ["./libs/components/menu/src/index.ts"],
      "@pacit/components/toast": ["./libs/components/toast/src/index.ts"],
      "@pacit/components/pagination": [
        "./libs/components/pagination/src/index.ts"
      ],
      "@pacit/components/progress": ["./libs/components/progress/src/index.ts"],
      "@pacit/components/skeleton": ["./libs/components/skeleton/src/index.ts"],
      "@pacit/components/chips": ["./libs/components/chips/src/index.ts"],
      "@pacit/components/avatar": ["./libs/components/avatar/src/index.ts"],
      "@pacit/components/badge": ["./libs/components/badge/src/index.ts"],
      "@pacit/components/breadcrumb": [
        "./libs/components/breadcrumb/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
