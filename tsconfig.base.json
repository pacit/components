{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@pacit/components": ["./libs/components/src/index.ts"],
      "@pacit/tokens": ["./libs/tokens/dist/tokens.ts"],
      "@pacit/components/core": ["./libs/components/core/src/index.ts"],
      "@pacit/components/button": ["./libs/components/button/src/index.ts"],
      "@pacit/components/checkbox": ["./libs/components/checkbox/src/index.ts"],
      "@pacit/components/radio": ["./libs/components/radio/src/index.ts"],
      "@pacit/components/select": ["./libs/components/select/src/index.ts"],
      "@pacit/components/field": ["./libs/components/field/src/index.ts"],
      "@pacit/components/icon": ["./libs/components/icon/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
