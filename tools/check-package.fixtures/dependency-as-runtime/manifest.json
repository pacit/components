{
  "name": "@pacit/components",
  "version": "0.0.1",
  "description": "The reference control package. It is not published and is never meant to be.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://example.invalid/pacit/components.git"
  },
  "peerDependencies": {
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "migrations": "./schematics/migration.json"
  },
  "exports": {
    "./themes/*": "./themes/*",
    "./schematics/*": "./schematics/*",
    ".": {
      "default": "./fesm2022/pacit-components.mjs"
    }
  },
  "module": "fesm2022/pacit-components.mjs",
  "type": "module"
}
