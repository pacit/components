{
  "$comment": "A dictionary with ordinals for the role `surface` alone \u2014 so that this case's only defect is an ordinal on another role.",
  "private": {
    "prefixes": ["pct.blue.", "pct.slate."]
  },
  "primitive": {
    "axes": ["blue", "slate", "space", "target", "control", "motion"]
  },
  "semantic": {
    "roles": ["primary", "surface", "text"],
    "variants": ["hover", "muted"],
    "ordinals": {
      "roles": ["surface"],
      "list": ["1"]
    }
  },
  "component": {
    "parts": ["close", "label"],
    "properties": ["bg", "fg", "height", "padding-x", "size", "z-index"],
    "states": ["hover"],
    "sizes": {
      "list": ["sm"]
    }
  }
}
