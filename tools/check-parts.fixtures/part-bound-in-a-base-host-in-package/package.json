{
  "entrypoints": [
    ".",
    "./widget"
  ],
  "classes": [
    {
      "entrypoint": "./widget",
      "className": "PctWidget",
      "declaration": {
        "selector": "pct-widget",
        "host": {
          "properties": {
            "attr.title": "value()"
          }
        },
        "usesInheritance": true,
        "extends": {
          "className": "PctWidgetMiddle",
          "undecorated": true,
          "extends": {
            "className": "PctWidgetBase",
            "kind": "Directive",
            "host": {
              "properties": {
                "attr.lang": "slot()"
              }
            },
            "usesInheritance": true,
            "extends": {
              "className": "PctWidgetRoot",
              "kind": "Directive",
              "host": {
                "properties": {
                  "attr.data-pct-part": "slot()"
                }
              }
            }
          }
        },
        "template": "<span class=\"pct-widget__label\" data-pct-part=\"label\">\n  <ng-content></ng-content>\n</span>\n<span class=\"pct-widget__value\" data-pct-part=\"value\">{{ value() }}</span>\n<!--\n  A loading block with `after` and no `minimum` puts `[null, 100]` into `consts`: a slot that\n  holds no name, which the package read passes over.\n-->\n@defer (on idle) {\n<span>later</span>\n} @loading (after 100ms) {\n<span>loading</span>\n}\n"
      }
    },
    {
      "entrypoint": "./widget",
      "className": "PctMarker",
      "parts": [
        "widget-marker",
        "widget-base"
      ],
      "dynamic": 0
    }
  ]
}
