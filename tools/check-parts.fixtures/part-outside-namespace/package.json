{
  "$comment": "The reading from the BUILT package, doctored with the case: `PctWidget` ships two parts carrying the component's prefix and one that does not. Both reads have to agree, or point 2 fires first and the case proves something else.",
  "entrypoints": [
    ".",
    "./widget"
  ],
  "classes": [
    {
      "entrypoint": "./widget",
      "className": "PctWidget",
      "parts": [
        "widget-label",
        "widget-value",
        "spinner"
      ],
      "dynamic": 0
    },
    {
      "entrypoint": "./widget",
      "className": "PctMarker",
      "declaration": {
        "kind": "Directive",
        "selector": "[pctMarker]",
        "host": {
          "attributes": {
            "data-pct-part": "widget-marker"
          },
          "classAttribute": "pct-marker"
        },
        "usesInheritance": true,
        "extends": {
          "className": "PctMarkerBase",
          "kind": "Directive",
          "host": {
            "classAttribute": "pct-marker-base"
          }
        }
      }
    },
    {
      "entrypoint": "./widget",
      "className": "PctMarkerOutline",
      "declaration": {
        "kind": "Directive",
        "selector": "[pctMarkerOutline]",
        "host": {
          "classAttribute": "pct-marker-outline"
        },
        "usesInheritance": true,
        "extends": {
          "className": "PctMarker",
          "kind": "Directive",
          "selector": "[pctMarker]",
          "host": {
            "attributes": {
              "data-pct-part": "widget-marker"
            },
            "classAttribute": "pct-marker"
          },
          "usesInheritance": true,
          "extends": {
            "className": "PctMarkerBase",
            "kind": "Directive",
            "host": {
              "classAttribute": "pct-marker-base"
            }
          }
        }
      }
    }
  ]
}
