{
  "entrypoints": [
    ".",
    "./widget",
    "./marker",
    "./other"
  ],
  "classes": [
    {
      "entrypoint": "./widget",
      "className": "PctWidget",
      "parts": [
        "label",
        "value"
      ],
      "dynamic": 0
    },
    {
      "className": "PctMarker",
      "exports": [
        {
          "entrypoint": "./marker",
          "as": "PctMarker"
        },
        {
          "entrypoint": "./other",
          "as": "PctMarker"
        }
      ],
      "declaration": {
        "kind": "Directive",
        "selector": "[pctMarker]",
        "host": {
          "attributes": {
            "data-pct-part": "widget-marker"
          },
          "classAttribute": "pct-marker"
        },
        "usesInheritance": true,
        "extends": {
          "className": "PctMarkerBase",
          "kind": "Directive",
          "host": {
            "classAttribute": "pct-marker-base"
          }
        }
      }
    },
    {
      "entrypoint": "./widget",
      "className": "PctMarkerOutline",
      "declaration": {
        "kind": "Directive",
        "selector": "[pctMarkerOutline]",
        "host": {
          "classAttribute": "pct-marker-outline"
        },
        "usesInheritance": true,
        "extends": {
          "className": "PctMarker",
          "kind": "Directive",
          "selector": "[pctMarker]",
          "host": {
            "attributes": {
              "data-pct-part": "widget-marker"
            },
            "classAttribute": "pct-marker"
          },
          "usesInheritance": true,
          "extends": {
            "className": "PctMarkerBase",
            "kind": "Directive",
            "host": {
              "classAttribute": "pct-marker-base"
            }
          }
        }
      }
    }
  ]
}
