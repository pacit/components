#!/usr/bin/env bash
# Runs an `nx` command, keeps the whole of its output in a file, shows it live, and refuses
# the run's silence.
#
# nx ends every run of tasks with one line of its own — `Successfully ran target(s) …`, or
# `Ran target(s) …` above a `Failed tasks:` list — and exits 1 on the second. Read off a PIPE
# that line is not to be trusted: Node drops what is still buffered on stdout when it leaves
# through `process.exit()`, as nx does the moment its tasks are done. A run whose tasks were all
# cached replays their output in seconds and leaves with thousands of lines unwritten, the
# summary among them — measured on 2026-09-18, twice on the runner and then on a desk
# (lesson-228); the nine silent runs of 2026-09-15..17 (lesson-222) may have lost theirs the
# same way, though the drop takes bytes and not nx's exit code, and their green stays
# lesson-222's open question. To a FILE nothing is dropped, because stdout to a file is
# synchronous: the command writes to one, `tail` follows it for the live log, and the
# verdict is read off the complete file once the command is gone. A verdict that never
# arrived is still not a pass, and nx's own non-zero code still wins.
#
# Usage:  scripts/nx-verdict npx nx affected -t …      NX_VERDICT_LOG names the file.
set -u -o pipefail
if [ "$#" -eq 0 ]; then
  echo "usage: scripts/nx-verdict <command …>" >&2
  exit 2
fi
log="${NX_VERDICT_LOG:-tmp/nx-verdict.log}"
mkdir -p "$(dirname "$log")"
: > "$log"
"$@" > "$log" 2>&1 &
command=$!
# `--pid` ends the tail once the command is gone, after its last read: on the runner's GNU
# tail the live lines and the file agree to the line on a 55 000-line replay. A desk whose
# `tail` is uutils can show the live output short when its reader is slow; the verdict is
# read off the file either way.
tail -n +1 -f --pid="$command" "$log" &
follower=$!
wait "$command"
status=$?
wait "$follower" 2>/dev/null
# `No tasks were run` is NOT on this list, and that is the point of the list. It is a sentence
# nx prints both when a diff reaches nothing and when a target list is a typo, and the two are
# not the same fact: the second is a run that checked nothing and looked fine. A job whose
# targets can legitimately come to nothing — the browser shards run `-t e2e` alone — decides
# that case BEFORE calling this script, where the workspace can still be asked whether such a
# target exists at all (ci.yml, the e2e job).
# The server's lines are struck out before the verdict is looked for, and that became
# necessary the day the e2e configurations set `webServer.stdout: 'pipe'`. The suites start a
# NESTED `nx` to serve the app they test, Playwright prefixes its output with `[WebServer] `
# and nothing else, and a nested run prints the same two sentences this reader takes for a
# verdict — `Successfully ran target serve for project sandbox` matches the first, a failed
# dependency build the second. An outer run that ended in the silence of lesson-222 would
# then have been passed on a nested run's summary, which is the one mistake this script
# exists to refuse. Not yet observed: the server is killed before it can print one. The
# prefix is Playwright's and carries its trailing space through the dim escape, but it is
# `webServer.name` when a configuration sets one — neither of ours does, and one that did
# would have to be told about here.
#
# COUNTED and not `grep -q`, which is not a style: `-q` leaves on the first match, the
# upstream `grep -v` dies of SIGPIPE with 4 MB still to write, and `pipefail` hands the `if`
# a 141 that reads exactly like "no verdict" — a GREEN run failed on the size of its own log.
# Measured: a summary followed by more than the pipe's 64 KB did it every time, and the four
# CI logs to hand escape only because their summary sits within 60 lines of the end. `-c`
# drains its input, so there is nothing to signal.
verdict=$(grep -v '\[WebServer\] ' "$log" | grep -c -e 'Successfully ran target' -e 'Failed tasks:')
if [ "${verdict:-0}" -eq 0 ]; then
  echo "::error::nx ended without its summary — neither 'Successfully ran' nor 'Failed tasks:' — so the run is not a verdict, and a task in it may have failed unseen (scripts/nx-verdict)."
  # The command's own code when it had one — 127 for a command that never started, 137 for
  # a killed one — and 1 for a run that ended clean and mute.
  exit "$(( status ? status : 1 ))"
fi
exit "$status"
