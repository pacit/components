#!/usr/bin/env bash
# Reads an `nx` run off its stdin, prints it through unchanged, and refuses the run's silence.
#
# nx ends every run of tasks with one line of its own — `Successfully ran target(s) …`, or
# `Ran target(s) …` above a `Failed tasks:` list — and exits 1 on the second. On the runners
# it did neither, nine times between 2026-09-15 and 2026-09-17: the step ended right after
# the last task's output, with exit code 0 and red tasks inside it (plan 4.72, lesson-222).
# GitHub reads the exit code alone, so those runs were green. This reader stands behind the
# pipe and turns the missing line into the failure it was: a verdict that never arrived is
# not a pass. The step's shell has `pipefail`, so nx's own non-zero code still wins.
#
# Both endings count as a verdict: the pass line, and the `Failed tasks:` list nx prints above
# its exit code 1 — the reader is not a second judge of a red run, only of a mute one.
#
# Usage:  npx nx affected -t … |& scripts/nx-verdict
verdict=0
while IFS= read -r line; do
  printf '%s\n' "$line"
  case "$line" in
    *'Successfully ran target'*) verdict=1 ;; # the pass — nx exits 0 with it
    *'Failed tasks:'*) verdict=1 ;;           # the failure — nx exits 1 with it, and pipefail keeps that
  esac
done
if [ "$verdict" -ne 1 ]; then
  echo "::error::nx ended without its summary — neither 'Successfully ran' nor 'Failed tasks:' — so the run is not a verdict, and a task in it may have failed unseen (scripts/nx-verdict)."
  exit 1
fi
