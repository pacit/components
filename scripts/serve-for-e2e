#!/usr/bin/env bash
# Starts the dev server a Playwright suite waits for, and puts a clock beside its silence.
#
# Playwright reports a server that never binds with one line — `Timed out waiting 240000ms
# from config.webServer` — and the two shards that failed that way on run 35408508618
# (2026-09-19) had printed NOT ONE line of server output in those four minutes. That reading
# was worth less than it looked. `webServer.stdout` defaults to `'ignore'`, and measured on a
# desk a healthy `nx run sandbox:serve` writes its nx header, its 29 seconds of `Building…`
# and its whole bundle table to STDOUT; on stderr it writes three bursts inside the first six
# seconds and then nothing until the port is up. So the empty four minutes is what this
# arrangement looks like from outside NO MATTER what the server was doing. The configurations
# pipe both streams now; this script adds the one thing a stream cannot carry — a line that
# arrives while nothing is being printed, saying how long it has been nothing.
#
# What that separates, read against the measured timeline: no line at all, and nx never
# started; `NX Running target …` and nothing after, and nx started while its task never did —
# reproduced on a desk by holding nx's own `workspace-data` lock, where a nested nx hangs for
# ever and mute, the only stall found that prints nothing; `❯ Building…` and nothing after,
# and the build is the slow part, which is a budget question and not this one. nx's OTHER
# lock is ruled out rather than listed: a nested nx blocked on the project-graph lock says
# `Waiting for graph construction in another process to complete` on stderr after 30 seconds,
# measured twice, and the two failing shards said nothing.
#
# `npx` stays in the command though it costs a measured 0.45 to 1.4 seconds over
# `node_modules/.bin/nx`. It is inside what stalled, and an instrument pointed at something
# other than the suspect answers a question nobody asked.
#
# Usage:  scripts/serve-for-e2e <nx target> <url>   e.g. `sandbox:serve http://localhost:4200`
set -u
if [ "$#" -ne 2 ]; then
  echo "usage: scripts/serve-for-e2e <nx-target> <url>" >&2
  exit 2
fi
target="$1"
url="$2"
every="${SERVE_FOR_E2E_HEARTBEAT:-15}"

# The host and port the heartbeat knocks on, taken from the url Playwright is waiting for so
# the two cannot name different servers.
hostport="${url#*://}"
hostport="${hostport%%/*}"
host="${hostport%%:*}"
port="${hostport##*:}"
if [ "$port" = "$host" ]; then
  case "$url" in
    https://*) port=443 ;;
    *) port=80 ;;
  esac
fi

# Both streams are the child's own — inherited, not read through this script. A wrapper that
# relays output is a wrapper that can buffer it, and the failure under investigation is
# already one of output that never arrived.
npx nx run "$target" &
server=$!

started=$SECONDS
# `/dev/tcp` and not curl: bash is the shebang, so the knock has no dependency to be missing
# on the one machine where it matters. It answers whether anything is listening, which is
# exactly what a server that never binds fails to do; between a listening port and the url
# Playwright asked for, Playwright's own error is the better witness and says so itself.
said=
while :; do
  sleep "$every" || break
  elapsed=$(( SECONDS - started ))
  # The child is asked about BEFORE the port is, because the port answers for whoever holds
  # it. Knocked on in the other order, a dead `nx` and a stranger's server on the same number
  # read as a healthy start — measured, on a desk where a second checkout was serving 4300.
  if ! kill -0 "$server" 2>/dev/null; then
    echo "[serve-for-e2e] $target: gone after ${elapsed}s, and $host:$port never answered while it lived — the code below is its own." >&2
    break
  fi
  if (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then
    echo "[serve-for-e2e] $target: $host:$port accepts connections after ${elapsed}s." >&2
    break
  fi
  # The first tick carries the sentence and the rest carry the clock: what a reader needs
  # from the sixteenth of them is when it was written, and the reason repeated sixteen times
  # is the noise a log of this failure has to be read through.
  if [ -z "$said" ]; then
    said=yes
    echo "[serve-for-e2e] $target: ${elapsed}s, and nothing is listening on $host:$port yet — whatever the server has printed by now is above this line, and a tick with nothing above it is a server that has not spoken at all." >&2
  else
    echo "[serve-for-e2e] $target: ${elapsed}s, still nothing on $host:$port." >&2
  fi
done

# The child's code is this script's code: Playwright tells a server that died from one that
# never bound, and only if the death reaches it.
wait "$server"
