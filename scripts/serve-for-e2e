#!/usr/bin/env bash
# Starts the dev server a Playwright suite waits for, and puts a clock beside its silence.
#
# Two shards of run 35408508618 timed out on a server that never bound, and the log could not
# say WHERE in the start it stopped. The whole account of that — which stream carries what,
# which suspect the measurements removed, which one they did not — is
# [`lesson-231`](../docs/lessons.md#lesson-231); the configurations that call this script
# carry the part a reader of them needs. What belongs here is the shape of the answer: a line
# on stderr that arrives WHILE nothing is being printed, saying how long it has been nothing,
# so the silence has a length and the last thing the server said has a time.
#
# `npx` stays in the command though it costs a measured 0.45 to 1.4 seconds over
# `node_modules/.bin/nx`. It is inside what stalled, and an instrument pointed at something
# other than the suspect answers a question nobody asked.
#
# Usage:  scripts/serve-for-e2e <nx target> <url>   e.g. `sandbox:serve http://localhost:4200`
set -u -o pipefail
if [ "$#" -ne 2 ]; then
  echo "usage: scripts/serve-for-e2e <nx-target> <url>" >&2
  exit 2
fi
target="$1"
url="$2"

# A heartbeat nobody can read is the failure this script exists to end, so a value that would
# switch it off says so instead of taking effect. `0` is refused with the rest: it would spin
# the loop into a flood, which hides the server's own lines as thoroughly as silence does.
every="${SERVE_FOR_E2E_HEARTBEAT:-15}"
case "$every" in
  '' | *[!0-9]* | 0)
    echo "[serve-for-e2e] SERVE_FOR_E2E_HEARTBEAT=$every is not a positive whole number of seconds; ticking every 15s instead." >&2
    every=15
    ;;
esac

# The host and port the heartbeat knocks on, read off the url the caller also hands Playwright.
hostport="${url#*://}"
hostport="${hostport%%/*}"
host="${hostport%%:*}"
port="${hostport##*:}"
if [ "$port" = "$host" ]; then
  case "$url" in
    https://*) port=443 ;;
    *) port=80 ;;
  esac
fi

knock() { (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; }

# Knocked once BEFORE anything is started, because the knock cannot tell whose server answers
# and a live child is no proof the answer is its. Measured: with a second checkout serving
# 4300 and `nx` still a second away from dying on a project that does not exist, the loop
# below called that a healthy start. Under Playwright this should never fire — it reuses or
# refuses a port already in use before it ever launches this script — so the line is for a
# person running the wrapper by hand, and it is the one they most need.
occupied=
if knock; then
  occupied=yes
  echo "[serve-for-e2e] $target: $host:$port was ALREADY answering before $target was started — whatever the times below are about, it is not this server." >&2
fi

# Both streams are the child's own — inherited, not read through this script. A wrapper that
# relays output is a wrapper that can buffer it, and the failure under investigation is
# already one of output that never arrived.
npx nx run "$target" &
server=$!

started=$SECONDS
next=$every
said=
# Knocked on EVERY SECOND and reported every `$every`, which are two different periods on
# purpose: the first version did both at once and could only ever name a multiple of 15, so
# all twelve servers of run 35434514356 reported `15s` or `30s` for builds that finished in
# 8. The log volume is the reporting period; the accuracy is the knocking one, and a server
# that dies is noticed in a second rather than at the next tick.
#
# `/dev/tcp` and not curl: one fewer thing to be missing on the machine where it matters.
# Net redirections are a bash build option rather than a guarantee of the shebang — MEASURED
# present on the runner by run 35434514356, where every one of the twelve servers reported.
# If a build ever lacks them the knock never succeeds, and the loop says so every `$every`
# seconds for the length of the suite, which is loud in the right direction.
while :; do
  sleep 1 || break
  now=$(( SECONDS - started ))
  # The child is asked about BEFORE the port is, because the port answers for whoever holds
  # it. Knocked on in the other order, a dead `nx` and a stranger's server on the same number
  # read as a healthy start — measured, on a desk where a second checkout was serving 4300.
  if ! kill -0 "$server" 2>/dev/null; then
    echo "[serve-for-e2e] $target: gone after ${now}s, and $host:$port never answered while it lived — the code below is its own." >&2
    break
  fi
  if knock; then
    if [ -n "$occupied" ]; then
      echo "[serve-for-e2e] $target: $host:$port answers at ${now}s, and was answering before $target started — this is a reading of somebody else's server." >&2
    else
      echo "[serve-for-e2e] $target: $host:$port accepts connections after ${now}s." >&2
    fi
    break
  fi
  [ "$now" -lt "$next" ] && continue
  next=$(( next + every ))
  # The first tick carries the sentence and the rest carry the clock: what a reader needs
  # from the sixteenth of them is when it was written, and the reason repeated sixteen times
  # is noise to read the server's own lines through.
  if [ -z "$said" ]; then
    said=yes
    echo "[serve-for-e2e] $target: ${now}s, and nothing is listening on $host:$port yet — whatever the server has printed by now is above this line, and a tick with nothing above it is a server that has not spoken at all." >&2
  else
    echo "[serve-for-e2e] $target: ${now}s, still nothing on $host:$port." >&2
  fi
done

# The child's code is this script's code: Playwright tells a server that died from one that
# never bound, and only if the death reaches it.
wait "$server"
