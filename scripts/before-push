#!/usr/bin/env bash
# The gates CI will run, run here first — the same list, taken from `ci.yml` itself rather
# than copied, so the two cannot drift. Measured on this desk 2026-09-18, over the 23 tasks a
# change under `tools/` touches: 52 seconds with `--cold`, 3 with the cache holding them, and
# some twenty minutes of waiting for a runner to say the same thing.
#
# `e2e` is left out by default: the two suites took 66 of the 68 minutes of the last
# unsharded run on a runner, and a change that cannot reach the browser has nothing to learn
# from them. Ask for them with `--e2e` — and get the WHOLE suite, not a shard: the workflow
# splits the run across six machines and this desk is one.
#
# A cached task is not a measurement. nx replays a result whose inputs did not move, and a
# change outside a target's inputs — a tool, a fixture, a workflow — leaves the target green
# without running it: on 2026-09-18 CI found `docs:typecheck` broken on a runner while this
# desk replayed a cached pass of it. `--cold` skips the cache for the whole run; use it when
# the change is one nx cannot see, and after `rm -rf apps/docs/src/generated` when the
# generated sources are what moved.
#
# Usage:  scripts/before-push [--e2e] [--cold] [--base=main]
set -u -o pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# nx reads the workspace off the working directory, and npx installs a fresh one when it finds
# none: run from anywhere else and the battery fetches an unpinned nx to tell you this is not a
# workspace. The script is callable from any directory, and always measures this one.
cd "$root" || {
  echo "::error::cannot enter $root — the battery measures the workspace it lives in." >&2
  exit 1
}
workflow="$root/.github/workflows/ci.yml"

base=main
extra=()
want_e2e=0
for arg in "$@"; do
  case "$arg" in
    --e2e) want_e2e=1 ;;
    --cold) extra+=(--skip-nx-cache) ;;
    --base=*) base="${arg#--base=}" ;;
    *)
      echo "usage: scripts/before-push [--e2e] [--cold] [--base=<ref>]" >&2
      exit 2
      ;;
  esac
done

# EVERY line in CI that runs targets, and not the first one. The workflow runs the battery in
# one job and the browsers in six more, so a reader that stopped at the first line would have
# dropped `e2e` off this battery the day that split landed — silently, because a list that is
# short still runs and still goes green. The union is over the lines; the order is the
# workflow's.
#
# What counts as a target is the rule the two gates that read the same file use
# (`targetsIn` in check-docs and in check-tools): the words after `-t` to the end of the
# line, minus any word beginning with a dash. That is what lets `--shard=…` stand on the e2e
# line without becoming a target nobody can run — and a line carrying no `-t` at all is an
# error here rather than a line quietly skipped.
if ! targets=$(awk '
  /npx nx affected/ {
    at = index($0, " -t ")
    if (at == 0) { bad = bad "\n    " $0; next }
    n = split(substr($0, at + 4), word, /[ \t]+/)
    for (i = 1; i <= n; i++)
      if (word[i] != "" && substr(word[i], 1, 1) != "-") print word[i]
  }
  END { if (bad != "") { printf "%s\n", bad > "/dev/stderr"; exit 3 } }
' "$workflow" | awk '!seen[$0]++'); then
  echo "::error::a \`npx nx affected\` line in .github/workflows/ci.yml carries no \`-t\` — the battery reads its targets from there, and it cannot read that line (printed above)." >&2
  exit 1
fi
if [ -z "$targets" ]; then
  echo "::error::no \`npx nx affected … -t …\` line in .github/workflows/ci.yml — the battery reads its targets from there, and the line has moved or changed shape." >&2
  exit 1
fi
if [ "$want_e2e" -eq 0 ]; then
  targets=$(printf '%s\n' "$targets" | grep -vx e2e || true)
fi

mapfile -t list <<<"$targets"
said="--base=$base${extra[0]+ ${extra[*]}}"
echo "> nx affected $said -t ${#list[@]} targets from ci.yml"
# `${extra[@]:-}` would hand nx an empty argument when no flag was given — harmless today,
# and a word this script never meant to say.
exec "$root/scripts/nx-verdict" "$root/scripts/with-node" npx nx affected \
  --base="$base" ${extra[@]+"${extra[@]}"} -t "${list[@]}"
